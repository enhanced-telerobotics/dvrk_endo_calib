<?xml version="1.0"?>
<package format="3">
  <name>dvrk_endo_calib</name>
  <version>0.1.0</version>
  <description>Collect dVRK ECM waypoints and stereo endoscope images.</description>
  <maintainer email="sxy841@case.edu">erie_lab</maintainer>
  <license>Unspecified</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>crtk_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
